param(:arm_length, default: 50.0, validate: { min: 30.0, max: 100.0 })
param(:resolution, default: 32)

# --- 1. Parameter Injection & VM Diagnostics ---
benchmark("Total Generation Time") do
  CAD.config(resolution: { segments: param(:resolution) })

  # --- 2. New 2D Primitives & Sweeps ---
  # Base motor mount using regular_polygon, offset, and extrude
  hex_base_2d = regular_polygon(6, r: 20).offset(1.5)
  hex_mount = hex_base_2d.extrude(6.0).material(color: "#2C3E50")

  # --- 3. New 3D Primitives & Alignment Helpers ---
  # Protective guard ring snapped to top of mount (Z = 6.0)
  guard_ring = torus(major_r: 24, minor_r: 2)
    .align(hex_mount, "Z", "min", "max") # Snap to hex_mount primitive
    .center("XY")
    .material(color: "#E74C3C")

  # --- 4. Polar Patterning (repeat_polar) ---
  hole_cutter = cylinder(d: 3.2, h: 20, center: true).translate(16.0, 0.0, 0.0)
  mounting_holes = hole_cutter.repeat_polar(6, angle: 360.0)

  motor_base = (hex_mount + guard_ring) - mounting_holes

  # --- 5. Linear Patterning (repeat_linear) ---
  # Create cooling ribs snapped to top of mount
  rib_2d = square(2.0, 10.0, center: true).offset(0.5)
  rib_3d = rib_2d.extrude(4.0).translate(0.0, 0.0, 2.0)
  rib_array = rib_3d.repeat_linear(7, 4.0, 0.0, 0.0)
    .center("X")
    .align(hex_mount, "Z", "min", "max") # Align to primitive hex_mount

  motor_base = motor_base + rib_array

  # --- 6. Batch Hull & Array Math ---
  arm_len = param(:arm_length)
  joint1 = sphere(r: 6.0).translate(20.0, 0.0, 3.0)
  joint2 = sphere(r: 4.0).translate(20.0 + arm_len, 0.0, 3.0)
  joint3 = sphere(r: 4.0).translate(20.0 + arm_len, 10.0, 3.0)

  arm_body = batch_hull([joint1, joint2, joint3]).material(color: "#34495E")

  # --- 7. Minkowski Sums & Alignment ---
  # Create rubber bumper aligned to the end joint sphere
  bumper_core = cube(4.0, 12.0, 6.0, center: true)
  bumper_soft = bumper_core.minkowski(sphere(r: 2.0))
    .align(joint2, "X", "center", "max") # Align to joint sphere
    .center("YZ")
    .material(color: "#F1C40F")

  # --- 8. Plane Splitting ---
  # Trim tip of bumper flat
  split_parts = bumper_soft.split_by_plane(1.0, 0.0, 0.0, 20.0 + arm_len + 2.0)
  flat_bumper = split_parts[0]

  # --- 9. Text & Embossing ---
  logo_2d = text("KUP", size: 6.0, font: :stencil)
  logo_3d = logo_2d.extrude(4.0).translate(20.0 + (arm_len / 2.0) - 8.0, -3.0, 5.0)

  puts("=== ISOLATION DIAGNOSTICS ===")

  # 1. Test Base Primitives
  inspect("1. hex_mount:", hex_mount.bbox)
  inspect("2. guard_ring:", guard_ring.bbox)
  inspect("3. mounting_holes:", mounting_holes.bbox)
  inspect("4. rib_array:", rib_array.bbox)

  # 2. Test Sub-Assemblies
  inspect("5. motor_base:", motor_base.bbox)
  inspect("6. arm_body:", arm_body.bbox)
  inspect("7. bumper_soft:", bumper_soft.bbox)
  inspect("8. flat_bumper:", flat_bumper.bbox)
  inspect("9. logo_3d:", logo_3d.bbox)

  puts("=============================")

  # --- 10. Unified CSG Assembly ---
  final_part = (motor_base + arm_body + flat_bumper) - logo_3d

  # Ghosted interference zone and highlighted sensor node
  # A ghost is shown and exported beside the model; it isn't one of the assembly's parts.
  cylinder(d: 40, h: 50).center("XY").align(hex_mount, "Z", "center").ghost
  sensor_node = sphere(r: 1.5).align(flat_bumper, "X", "min", "max").center("YZ").highlight

  drone_arm_assembly = assemble(name: "DroneArm", parts: [
    final_part,
    sensor_node,
  ])

  # --- 11. Spatial Inspection API ---
  puts("--- Drone Arm Diagnostics ---")
  inspect("Bounds (X, Y, Z):", [
    final_part.bbox.x_size.round(2),
    final_part.bbox.y_size.round(2),
    final_part.bbox.z_size.round(2),
  ])
  inspect("Total Volume:", final_part.volume.round(1))
  inspect("Surface Area:", final_part.surface_area.round(1))
  inspect("Topology Holes (Genus):", final_part.genus)

  # Raycast down the motor shaft hole
  hits = final_part.ray_cast([0.0, 0.0, 50.0], [0.0, 0.0, -50.0])
  inspect("Motor Shaft Ray Intersections:", hits.length)
  # Each hit's crossing is +1 into the material and -1 out of it: the material along the ray
  shaft_material = hits.map { |h| -h["crossing"] * h["distance"] }.sum
  inspect("Material Along Motor Shaft:", shaft_material.round(2))

  # Check minimum clearance to a theoretical payload
  payload = cube(20.0, 20.0, 20.0, center: true).translate(20.0 + arm_len, 30.0, 0.0)
  inspect("Clearance to payload:", final_part.min_gap(payload).round(2))

  # ==========================================
  # DEBUG EXPORT ISOLATION
  # ==========================================
  # Uncomment ONLY ONE of the lines below to export a specific sub-assembly.
  # This will pinpoint which geometric operation breaks the B-Rep graph.

  # 1. Test Base assembly (Booleans and Arrays)
  # motor_base

  # 2. Test the Minkowski + Plane Slicing
  # flat_bumper

  # 3. Test the Arm Body (Batch Hull)
  # arm_body

  # 4. Test the pre-text unified part
  # (motor_base + arm_body + flat_bumper)

  # 5. Test the final part (Subtraction of 3D Text)
  # final_part

  # 6. Default: The full assembly (Includes ghosted/highlighted parts)
  drone_arm_assembly
end # End Benchmark
